extends RefCounted
## Passive tree rules (Phase 1 of the passive tree plan). Pure functions over plain data,
## so the tests can feed them broken trees. Used by:
##   - CharacterData.from_dict (is an old allocation still legal?)
##   - tests/test_passive_tree.gd and tests/tree_only.tscn (the validator)
## Sources: data/passive_tree.json (generated by tools/gen_clusters.py),
## data/passive_flags.json (flag registry, tag vocabulary, point budget),
## data/passive_migrations.json (tree_version and id history).

const NODE_TYPES := ["start", "minor", "greater", "notable", "keystone", "mastery", "socket"]
const REQUIRED := ["id", "name", "type", "mods", "x", "y", "cost", "links", "cluster", "tags"]
const OPTIONAL := ["desc", "flags", "class", "gen", "drawback", "exclusive_with", "rev", "art_id", "mastery"]
const MOD_TYPES := ["flat", "inc", "more"]
## Node types a route may end on but never pass through.
const NO_ROUTE := ["start", "keystone", "mastery", "socket"]

static func tree_version(mig: Dictionary) -> int:
	return maxi(1, int(mig.get("tree_version", 1)))

static func index(nodes: Array) -> Dictionary:
	var d := {}
	for n in nodes:
		if typeof(n) == TYPE_DICTIONARY and n.has("id"):
			d[str(n["id"])] = n
	return d

## Cheapest point cost from start to every node, following the same rule as
## CharacterData.path_to: you may end on a keystone, mastery or socket but never route
## through one (or through another class start). Returns {id: cost}.
static func cheapest_costs(by_id: Dictionary, start: String) -> Dictionary:
	var dist := {start: 0}
	var open := [start]
	while open.size() > 0:
		var bi := 0
		for i in open.size():
			if dist[open[i]] < dist[open[bi]]:
				bi = i
		var cur: String = open[bi]
		open.remove_at(bi)
		if cur != start and str(by_id[cur].get("type", "")) in NO_ROUTE:
			continue   # can be reached, cannot be passed through
		for l in by_id[cur].get("links", []):
			if not by_id.has(l):
				continue
			var c: int = dist[cur] + int(by_id[l].get("cost", 1))
			if not dist.has(l) or c < dist[l]:
				dist[l] = c
				if not open.has(l):
					open.append(l)
	return dist

## Why an allocation cannot be kept as-is ("" = fine). Order of checks is stable so
## messages are predictable in tests.
## choices (Phase 4a): mastery node id -> option id. null skips the mastery checks;
## masteries is the registry (passive_flags.json "masteries").
static func allocation_problem(allocated: Array, start: String, points: int, by_id: Dictionary, choices = null, masteries: Dictionary = {}) -> String:
	if start == "" or not by_id.has(start):
		return "class start missing from the tree"
	if not allocated.has(start):
		return "class start not allocated"
	var seen_ids := {}
	var spent := 0
	for id in allocated:
		if not by_id.has(id):
			return "node %s no longer exists" % id
		if seen_ids.has(id):
			return "node %s allocated twice" % id
		seen_ids[id] = true
		if id != start and by_id[id].get("type") == "start":
			return "another class start (%s) is allocated" % id
		spent += int(by_id[id].get("cost", 1))
		for x in by_id[id].get("exclusive_with", []):
			if allocated.has(x):
				return "%s and %s are mutually exclusive" % [id, x]
	if spent > points:
		return "%d points spent but only %d available" % [spent, points]
	var reach := {start: true}
	var q := [start]
	while q.size() > 0:
		var c = q.pop_back()
		for l in by_id[c].get("links", []):
			if seen_ids.has(l) and not reach.has(l):
				reach[l] = true
				q.append(l)
	for id in allocated:
		if not reach.has(id):
			return "node %s is not connected to the class start" % id
	if choices != null:
		return mastery_problem(allocated, by_id, choices, masteries)
	return ""

## The option dictionary for group/option ({} when either is unknown).
static func mastery_option(masteries: Dictionary, group: String, option_id: String) -> Dictionary:
	for o in masteries.get(group, {}).get("options", []):
		if str(o.get("id", "")) == option_id:
			return o
	return {}

## Every allocated mastery has one valid option of its own group, no option is chosen
## twice, and no choice is kept for a node that is not an allocated mastery.
static func mastery_problem(allocated: Array, by_id: Dictionary, choices: Dictionary, masteries: Dictionary) -> String:
	var used := {}
	for id in allocated:
		if str(by_id.get(id, {}).get("type", "")) != "mastery":
			continue
		if not choices.has(id):
			return "mastery %s has no chosen effect" % id
		var opt := str(choices[id])
		if mastery_option(masteries, str(by_id[id].get("mastery", "")), opt).is_empty():
			return "mastery %s: effect %s is not one of its options" % [id, opt]
		if used.has(opt):
			return "effect %s is chosen on both %s and %s" % [opt, used[opt], id]
		used[opt] = id
	for id in choices:
		if not allocated.has(id) or str(by_id.get(id, {}).get("type", "")) != "mastery":
			return "a mastery effect is kept for %s, which is not an allocated mastery" % id
	return ""

## Full validation. Returns {"errors": [...], "warnings": [...], "report": {...}}.
## classes: Data.classes (id -> {start_passive}).
static func validate(nodes: Array, reg: Dictionary, mig: Dictionary, classes: Dictionary) -> Dictionary:
	var errors := []
	var warnings := []
	var by_id := {}
	var flag_reg: Dictionary = reg.get("flags", {})
	var tag_vocab: Array = reg.get("tags", [])
	var pending: Dictionary = reg.get("pending_rework", {})
	var used_flags := {}
	var masteries: Dictionary = reg.get("masteries", {})
	var used_groups := {}
	var re := RegEx.new()
	re.compile("^[a-z][a-z0-9_]*$")
	# --- per node
	for n in nodes:
		if typeof(n) != TYPE_DICTIONARY:
			errors.append("a node is not an object")
			continue
		var id := str(n.get("id", ""))
		if id == "" or re.search(id) == null:
			errors.append("bad node id '%s'" % id)
			continue
		if by_id.has(id):
			errors.append("duplicate id %s" % id)
		by_id[id] = n
		for k in REQUIRED:
			if not n.has(k):
				errors.append("%s: missing '%s'" % [id, k])
		for k in n:
			if not (k in REQUIRED or k in OPTIONAL):
				errors.append("%s: unknown key '%s'" % [id, k])
		var t := str(n.get("type", ""))
		if not (t in NODE_TYPES):
			errors.append("%s: unknown type '%s'" % [id, t])
		var cost = n.get("cost", 1)
		if not (typeof(cost) in [TYPE_INT, TYPE_FLOAT]) or int(cost) != cost or int(cost) < 0:
			errors.append("%s: cost must be a whole number >= 0" % id)
		elif (t == "start") != (int(cost) == 0):
			errors.append("%s: only start nodes cost 0" % id)
		var tags = n.get("tags", [])
		if typeof(tags) != TYPE_ARRAY or tags.is_empty():
			errors.append("%s: needs at least one tag" % id)
		else:
			for tg in tags:
				if not (tg in tag_vocab):
					errors.append("%s: tag '%s' is not in the vocabulary" % [id, tg])
		for f in n.get("flags", []):
			used_flags[f] = true
			if not flag_reg.has(f):
				errors.append("%s: flag '%s' is not in data/passive_flags.json" % [id, f])
		for m in n.get("mods", []):
			if not (str(m.get("type", "")) in MOD_TYPES):
				errors.append("%s: mod type '%s'" % [id, m.get("type")])
			elif m.get("type") == "more" and t != "keystone":
				errors.append("%s: 'more' modifiers are only allowed on keystones" % id)
		if t == "keystone":
			if str(n.get("drawback", "")).strip_edges() == "":
				if pending.has(id):
					warnings.append("%s: no drawback yet (%s)" % [id, pending[id]])
				else:
					errors.append("%s: keystone without a drawback" % id)
		elif n.has("drawback"):
			errors.append("%s: only keystones carry 'drawback'" % id)
		if t == "mastery":
			var grp := str(n.get("mastery", ""))
			if not masteries.has(grp):
				errors.append("%s: mastery group '%s' is not in passive_flags.json masteries" % [id, grp])
			else:
				used_groups[grp] = true
			if int(n.get("cost", 1)) != 1:
				errors.append("%s: masteries cost 1 point" % id)
			if not n.get("mods", []).is_empty() or n.has("flags"):
				errors.append("%s: a mastery's effects come from its options, not mods/flags" % id)
		elif n.has("mastery"):
			errors.append("%s: only mastery nodes carry 'mastery'" % id)
		if t == "socket":
			if int(n.get("cost", 1)) != 1:
				errors.append("%s: sockets cost 1 point" % id)
			if not n.get("mods", []).is_empty() or n.has("flags"):
				errors.append("%s: a socket's effects come from its gem, not mods/flags" % id)
		if n.has("rev") and (not (typeof(n["rev"]) in [TYPE_INT, TYPE_FLOAT]) or int(n["rev"]) < 1):
			errors.append("%s: rev must be >= 1" % id)
	# --- links
	for id in by_id:
		var links = by_id[id].get("links", [])
		var seen := {}
		for l in links:
			if l == id:
				errors.append("%s links to itself" % id)
			elif seen.has(l):
				errors.append("%s links to %s twice" % [id, l])
			elif not by_id.has(l):
				errors.append("%s links to missing node %s" % [id, l])
			elif not by_id[l].get("links", []).has(id):
				errors.append("link %s -> %s is not symmetric" % [id, l])
			seen[l] = true
			if by_id.has(l) and str(by_id[id].get("type", "")) in ["mastery", "socket"] and str(by_id[l].get("type", "")) in NO_ROUTE:
				errors.append("%s %s must hang off a normal node, not %s" % [by_id[id]["type"], id, l])
		for x in by_id[id].get("exclusive_with", []):
			if not by_id.has(x):
				errors.append("%s: exclusive_with missing node %s" % [id, x])
			elif not by_id[x].get("exclusive_with", []).has(id):
				errors.append("%s: exclusive_with %s is not mutual" % [id, x])
	# --- reachability and budget per class
	var budget := int(reg.get("budget_l60", 72))
	var starts := {}
	var report := {"nodes": by_id.size(), "keystone_cost": {}, "status_coverage": {}, "types": {}}
	for cls in classes:
		var s: String = classes[cls].get("start_passive", "")
		if not by_id.has(s) or by_id[s].get("type") != "start":
			errors.append("class %s: start node '%s' missing" % [cls, s])
			continue
		starts[s] = cls
	var reached := {}
	for s in starts:
		var cls: String = starts[s]
		var costs := cheapest_costs(by_id, s)
		for id in costs:
			reached[id] = true
		var kc := {}
		for id in by_id:
			if by_id[id].get("type") == "keystone":
				if not costs.has(id):
					errors.append("class %s cannot reach keystone %s" % [cls, id])
				else:
					kc[id] = costs[id]
					if costs[id] > budget:
						errors.append("class %s: keystone %s costs %d points (> budget %d)" % [cls, id, costs[id], budget])
		report["keystone_cost"][cls] = kc
	for id in by_id:
		var t: String = str(by_id[id].get("type", ""))
		report["types"][t] = int(report["types"].get(t, 0)) + 1
		if not reached.has(id):
			errors.append("%s is not reachable from any class start" % id)
	for s in by_id:
		if by_id[s].get("type") == "start" and not starts.has(s):
			warnings.append("start node %s belongs to no class" % s)
	# --- flag registry
	for f in flag_reg:
		if not (str(flag_reg[f].get("kind", "")) in ["behaviour", "marker"]):
			errors.append("flag %s: kind must be behaviour or marker" % f)
		if not used_flags.has(f):
			warnings.append("flag %s is registered but no node uses it" % f)
	for id in pending:
		if not by_id.has(id):
			errors.append("pending_rework lists missing node %s" % id)
	# --- mastery registry (Phase 4a)
	var opt_ids := {}
	for g in masteries:
		var gd = masteries[g]
		if typeof(gd) != TYPE_DICTIONARY or str(gd.get("name", "")) == "":
			errors.append("mastery group %s needs a name" % g)
			continue
		var opts = gd.get("options", [])
		if typeof(opts) != TYPE_ARRAY or opts.size() < 2:
			errors.append("mastery group %s needs at least 2 options" % g)
			continue
		for o in opts:
			var oid := str(o.get("id", ""))
			if re.search(oid) == null:
				errors.append("mastery %s: bad option id '%s'" % [g, oid])
			elif opt_ids.has(oid):
				errors.append("mastery option id %s is used twice (%s, %s)" % [oid, opt_ids[oid], g])
			opt_ids[oid] = g
			if str(o.get("name", "")) == "":
				errors.append("mastery option %s needs a name" % oid)
			if o.get("mods", []).is_empty() and o.get("flags", []).is_empty():
				errors.append("mastery option %s does nothing" % oid)
			for m in o.get("mods", []):
				if not (str(m.get("type", "")) in ["flat", "inc"]):
					errors.append("mastery option %s: mod type '%s' (only flat/inc)" % [oid, m.get("type")])
			for f in o.get("flags", []):
				used_flags[f] = true
				if not flag_reg.has(f):
					errors.append("mastery option %s: flag '%s' is not registered" % [oid, f])
		if not used_groups.has(g):
			warnings.append("mastery group %s is not placed on the tree" % g)
	# --- tree sockets (Phase 4b)
	var sock_n := int(report["types"].get("socket", 0))
	if sock_n > 0:
		var sc = reg.get("tree_sockets", {})
		if typeof(sc) != TYPE_DICTIONARY or float(sc.get("radius", 0)) <= 0:
			errors.append("tree_sockets: radius must be > 0")
		elif typeof(sc.get("boost_pct", null)) != TYPE_ARRAY or sc["boost_pct"].is_empty():
			errors.append("tree_sockets: boost_pct must list one value per gem tier")
	# --- migrations
	var ver = mig.get("tree_version", 0)
	if not (typeof(ver) in [TYPE_INT, TYPE_FLOAT]) or int(ver) < 1:
		errors.append("passive_migrations: tree_version must be >= 1")
	var hist = mig.get("history", {})
	if typeof(hist) != TYPE_DICTIONARY:
		errors.append("passive_migrations: history must be an object")
		hist = {}
	for v in hist:
		if not str(v).is_valid_int() or int(v) < 2 or int(v) > int(ver):
			errors.append("passive_migrations: history version '%s' must be 2..tree_version" % v)
		var m = hist[v]
		if typeof(m) != TYPE_DICTIONARY:
			errors.append("passive_migrations: history[%s] must be an object" % v)
			continue
		for old in m:
			if by_id.has(old) and m[old] != old:
				errors.append("passive_migrations v%s: removed id %s still exists (ids are never reused)" % [v, old])
			if m[old] != null and not by_id.has(str(m[old])):
				# may point at an id that was itself migrated later
				var later := false
				for v2 in hist:
					if int(v2) > int(v) and hist[v2].has(str(m[old])):
						later = true
				if not later:
					errors.append("passive_migrations v%s: %s -> %s, target missing" % [v, old, m[old]])
	# --- status coverage (report only until Phase 2/3 fill it in)
	for st in reg.get("statuses", []):
		var c := 0
		for id in by_id:
			if by_id[id].get("tags", []).has(st):
				c += 1
		report["status_coverage"][st] = c
	return {"errors": errors, "warnings": warnings, "report": report}

## Follows the migration history from an old id to its current id ("" when removed).
static func migrate_id(id: String, from_version: int, mig: Dictionary) -> String:
	var hist: Dictionary = mig.get("history", {})
	var cur := id
	for v in range(from_version + 1, tree_version(mig) + 1):
		var m: Dictionary = hist.get(str(v), {})
		if m.has(cur):
			cur = "" if m[cur] == null else str(m[cur])
			if cur == "":
				return ""
	return cur

# ---------------------------------------------------------------- tree sockets (Phase 4b)
## The radius boost of socketed gems: {node_id: percent} for every allocated node of a
## boost type (cfg.boost_types) within cfg.radius of an allocated socket whose gem shares a
## tag with the node. A node in range of several matching sockets takes the largest boost.
## sockets: socket node id -> gem id ("ruby:2"); gems: Data.gems (base id -> definition).
static func socket_boosts(by_id: Dictionary, allocated: Array, sockets: Dictionary, cfg: Dictionary, gems: Dictionary) -> Dictionary:
	var out := {}
	var r := float(cfg.get("radius", 0))
	var pcts: Array = cfg.get("boost_pct", [])
	var types: Array = cfg.get("boost_types", ["minor", "greater", "notable"])
	if r <= 0 or pcts.is_empty():
		return out
	for sid in sockets:
		if not allocated.has(sid) or str(by_id.get(sid, {}).get("type", "")) != "socket":
			continue
		var gid := str(sockets[sid])
		var g: Dictionary = gems.get(gid.get_slice(":", 0), {})
		if g.is_empty():
			continue
		var pct := float(pcts[clampi(int(gid.get_slice(":", 1)), 0, pcts.size() - 1)])
		var gtags: Array = g.get("tree_tags", [])
		var sp := Vector2(float(by_id[sid]["x"]), float(by_id[sid]["y"]))
		for id in allocated:
			var n: Dictionary = by_id.get(id, {})
			if n.is_empty() or not (str(n.get("type", "")) in types):
				continue
			if sp.distance_to(Vector2(float(n["x"]), float(n["y"]))) > r:
				continue
			var hit := false
			for tg in n.get("tags", []):
				if gtags.has(tg):
					hit = true
					break
			if hit and pct > float(out.get(id, 0.0)):
				out[id] = pct
	return out

## Nodes (any allocation state) of a boost type inside a socket's radius. For the UI.
static func nodes_in_radius(by_id: Dictionary, socket_id: String, cfg: Dictionary) -> Array:
	var out := []
	var sn: Dictionary = by_id.get(socket_id, {})
	if sn.is_empty():
		return out
	var r := float(cfg.get("radius", 0))
	var types: Array = cfg.get("boost_types", ["minor", "greater", "notable"])
	var sp := Vector2(float(sn["x"]), float(sn["y"]))
	for id in by_id:
		var n: Dictionary = by_id[id]
		if str(n.get("type", "")) in types and sp.distance_to(Vector2(float(n["x"]), float(n["y"]))) <= r:
			out.append(id)
	return out

# ---------------------------------------------------------------- UI helpers (Phase 5a)
## Groups for the "what my tree does" summary, matched in order against the stat key.
## Attributes match exactly; the others match a substring. Unmatched stats go to "General".
const STAT_THEMES := [
	["Attributes", ["str", "dex", "int", "vit", "agi", "wil"], true],
	["Defence", ["res_", "armour", "evasion", "block", "damage_reduction", "stun_threshold"], false],
	["Minions", ["minion"], false],
	["Traps & turrets", ["trap", "turret"], false],
	["Fire", ["fire"], false],
	["Cold", ["cold"], false],
	["Lightning", ["lightning"], false],
	["Void", ["void"], false],
	["Arcane", ["arcane"], false],
	["Elemental", ["elemental"], false],
	["Physical", ["physical"], false],
	["Ailments", ["bleed", "ignite", "dot_", "status_"], false],
	["Critical", ["crit"], false],
	["Projectiles", ["projectile", "bow", "firearm", "pierce", "chain"], false],
	["Attacks", ["melee", "attack", "one_handed", "two_handed"], false],
	["Spells", ["spell", "cast", "mana_cost"], false],
	["Life & mana", ["life", "mana"], false],
	["Speed", ["speed"], false],
]

static func stat_theme(stat: String) -> String:
	for th in STAT_THEMES:
		for k in th[1]:
			if (th[2] and stat == k) or (not th[2] and stat.contains(k)):
				return th[0]
	return "General"

static func theme_order() -> Array:
	var out := []
	for th in STAT_THEMES:
		out.append(th[0])
	out.append("General")
	return out

## A node that changes how you play (for the "behaviour only" filter): keystones, masteries,
## sockets and any node carrying a flag.
static func is_behaviour_node(n: Dictionary) -> bool:
	return str(n.get("type", "")) in ["keystone", "mastery", "socket"] or not n.get("flags", []).is_empty()

## Adds mod m (value scaled by mult, except "more") into sums keyed "stat|type".
## "more" mods combine multiplicatively; flat and inc add.
static func sum_mod(sums: Dictionary, m: Dictionary, mult: float = 1.0) -> void:
	var st := str(m.get("stat", ""))
	var ty := str(m.get("type", "flat"))
	var v := float(m.get("value", 0))
	var key := st + "|" + ty
	if not sums.has(key):
		sums[key] = {"stat": st, "type": ty, "value": 0.0}
	if ty == "more":
		var cur := float(sums[key]["value"])
		sums[key]["value"] = ((1.0 + cur / 100.0) * (1.0 + v / 100.0) - 1.0) * 100.0
	else:
		sums[key]["value"] = float(sums[key]["value"]) + v * mult

# ---------------------------------------------------------------- build codes (Phase 5b)
## Build code: BUILD_PREFIX + URL-safe base64 (no padding) of
##   [3-byte big-endian JSON length] + DEFLATE(JSON with sorted keys).
## JSON: {"v": 1, "c": class id, "t": tree_version, "n": [node ids, start excluded],
##        "m": {mastery id: option id}, "g": {socket id: gem base id}}.
## Gems are items, so "g" is only a suggestion; mastery choices are applied on import.
const BUILD_PREFIX := "POD1-"
const BUILD_FORMAT := 1
const BUILD_MAX_JSON := 65536
const B64_CHARS := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

static func encode_build(d: Dictionary) -> String:
	var txt := JSON.stringify(d, "", true)
	var raw := txt.to_utf8_buffer()
	var z := raw.compress(FileAccess.COMPRESSION_DEFLATE)
	var buf := PackedByteArray([(raw.size() >> 16) & 255, (raw.size() >> 8) & 255, raw.size() & 255])
	buf.append_array(z)
	var b64 := Marshalls.raw_to_base64(buf)
	return BUILD_PREFIX + b64.replace("+", "-").replace("/", "_").replace("=", "")

## {"error": "" or why, "data": Dictionary}. Never trusts the code: checks the prefix,
## alphabet, declared length, decompressed size, JSON shape and field types.
static func decode_build(code: String) -> Dictionary:
	var s := code.strip_edges().replace(" ", "").replace("\n", "").replace("\r", "").replace("\t", "")
	if not s.begins_with(BUILD_PREFIX):
		return {"error": "Not a Path of Dan build code (it should start with %s)" % BUILD_PREFIX, "data": {}}
	s = s.substr(BUILD_PREFIX.length())
	if s.length() < 8 or s.length() > 200000:
		return {"error": "The build code is too short or too long", "data": {}}
	for ch in s:
		if not B64_CHARS.contains(ch):
			return {"error": "The build code contains invalid characters", "data": {}}
	if s.length() % 4 == 1:
		return {"error": "The build code is cut off", "data": {}}
	s = s.replace("-", "+").replace("_", "/")
	while s.length() % 4 != 0:
		s += "="
	var buf := Marshalls.base64_to_raw(s)
	if buf.size() < 4:
		return {"error": "The build code is damaged", "data": {}}
	var n := (buf[0] << 16) | (buf[1] << 8) | buf[2]
	if n <= 0 or n > BUILD_MAX_JSON:
		return {"error": "The build code is damaged", "data": {}}
	var raw := buf.slice(3).decompress(n, FileAccess.COMPRESSION_DEFLATE)
	if raw.size() != n:
		return {"error": "The build code is damaged", "data": {}}
	var j := JSON.new()
	if j.parse(raw.get_string_from_utf8()) != OK or typeof(j.data) != TYPE_DICTIONARY:
		return {"error": "The build code is damaged", "data": {}}
	var d: Dictionary = j.data
	if int(d.get("v", 0)) != BUILD_FORMAT:
		return {"error": "Unknown build code format", "data": {}}
	if typeof(d.get("c")) != TYPE_STRING or typeof(d.get("n", [])) != TYPE_ARRAY \
			or typeof(d.get("m", {})) != TYPE_DICTIONARY or typeof(d.get("g", {})) != TYPE_DICTIONARY:
		return {"error": "The build code is damaged", "data": {}}
	var out := {"v": BUILD_FORMAT, "c": str(d["c"]), "t": maxi(1, int(d.get("t", 1))), "n": [], "m": {}, "g": {}}
	for id in d.get("n", []):
		if typeof(id) == TYPE_STRING:
			out["n"].append(id)
	for k in d.get("m", {}):
		out["m"][str(k)] = str(d["m"][k])
	for k in d.get("g", {}):
		out["g"][str(k)] = str(d["g"][k])
	return {"error": "", "data": out}

## Turns wanted node ids into a legal plan on top of an existing allocation.
## Drops: unknown ids, class starts, nodes already allocated, duplicates, nodes exclusive with
## the allocation or an earlier kept node, masteries without a valid free option, and every
## node that does not connect to the allocation through kept nodes.
## used_options: option id -> true for options already chosen by allocated masteries.
## Returns {"nodes": [ids, nearest-to-web first], "choices": {mastery: option}, "dropped": [ids]}.
static func sanitize_plan(wanted: Array, choices: Dictionary, allocated: Array, by_id: Dictionary, masteries: Dictionary, used_options: Dictionary) -> Dictionary:
	var alloc := {}
	for id in allocated:
		alloc[str(id)] = true
	var dropped := []
	var kept := {}
	var order := []
	var ch_out := {}
	var used := used_options.duplicate()
	for w in wanted:
		var id := str(w)
		if alloc.has(id) or kept.has(id):
			continue
		var n: Dictionary = by_id.get(id, {})
		if n.is_empty() or str(n.get("type", "")) == "start":
			dropped.append(id)
			continue
		var bad := false
		for x in n.get("exclusive_with", []):
			if alloc.has(x) or kept.has(x):
				bad = true
		if not bad and str(n.get("type", "")) == "mastery":
			var opt := str(choices.get(id, ""))
			if opt == "" or used.has(opt) or mastery_option(masteries, str(n.get("mastery", "")), opt).is_empty():
				bad = true
			else:
				used[opt] = true
				ch_out[id] = opt
		if bad:
			dropped.append(id)
			continue
		kept[id] = true
		order.append(id)
	# connectivity: breadth-first from the allocation through kept nodes
	var reached := {}
	var bfs := []
	var q := allocated.duplicate()
	var qi := 0
	while qi < q.size():
		var cur := str(q[qi])
		qi += 1
		for l in by_id.get(cur, {}).get("links", []):
			if kept.has(l) and not reached.has(l):
				reached[l] = true
				bfs.append(l)
				q.append(l)
	for id in order:
		if not reached.has(id):
			dropped.append(id)
			ch_out.erase(id)
	return {"nodes": bfs, "choices": ch_out, "dropped": dropped}
